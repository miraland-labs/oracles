# oracle-rwa-transfer environment template.
#
# Inherits the canonical layout from oracles/.env.example. The only family-specific
# variable is `TRANSFER_CLUSTER`; everything else is the standard `OracleConfig`
# surface (RPC, keypair, registry backend, operator token, etc.).
#
# Copy to /etc/oracle/rwa-transfer.env (mode 0600) before starting the binary.

# ---- Standard OracleConfig env vars (see oracles/.env.example for full docs) ----

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
ORACLE_KEYPAIR_PATH=/var/lib/oracle/rwa-transfer/oracle-keypair.json

# ESCROW_PROGRAM_ID=

BIND_ADDR=0.0.0.0:4021
EVALUATION_TIMEOUT_MS=30000

EVIDENCE_REGISTRY_URL=https://your-registry.example.com/evidence
EVIDENCE_FETCH_MAX_RETRIES=3
EVIDENCE_FETCH_RETRY_BASE_MS=200

DATABASE_URL=postgres://oracle:secret@127.0.0.1:5432/oracle_rwa_transfer

ORACLE_REGISTRY_BACKEND=postgres
ORACLE_REGISTRY_MAX_BYTEA_BYTES=4194304
ORACLE_REGISTRY_MAX_BLOB_BYTES=5368709120

# ORACLE_REGISTRY_S3_ENDPOINT=
# ORACLE_REGISTRY_S3_BUCKET=
# ORACLE_REGISTRY_S3_ACCESS_KEY=
# ORACLE_REGISTRY_S3_SECRET_KEY=
# ORACLE_REGISTRY_S3_REGION=us-east-1

# ORACLE_OPERATOR_TOKEN_SHA256=
# ORACLE_OPERATOR_TOKEN=

ORACLE_STRICT_PROFILE=true
ORACLE_DEAD_LETTER_MAX_ATTEMPTS=5
ORACLE_JOB_CHANNEL_CAPACITY=256
ORACLE_REQUIRE_EVENT_MATCH=false
ORACLE_BACKFILL_LOOKBACK_SIGNATURES=2000

# ---- Active Guardian (retry + fail-closed reject) ----
ORACLE_RETRY_INITIAL_DELAY_SEC=10
ORACLE_RETRY_MAX_DELAY_SEC=120
ORACLE_MAX_RETRY_ATTEMPTS=30
ORACLE_REJECT_SAFETY_MARGIN_SEC=600

# ---- Operator economics: tip-floor gate (default OFF) ----
# See oracles/.env.example for the full description and per-mint override map.
ORACLE_TIP_FLOOR_ENABLED=false
# ORACLE_MIN_VERDICT_TIP_DEFAULT_RAW=5000
# ORACLE_MIN_VERDICT_TIP_BY_MINT_RAW={}

# ---- Family-specific ----

# Cluster the evaluator verifies against. SLA `cluster` field MUST equal this value
# or the verdict is rejected with Custom(261) (TransferClusterMismatch).
TRANSFER_CLUSTER=devnet

# ---- Logging ----
RUST_LOG=oracle_rwa_transfer=info,oracle_common=info,tower_http=info
