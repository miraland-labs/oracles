# Copy to /etc/oracle/<family>.env and adjust for your deployment.
#
# Every variable below is consumed by `oracle_common::config::OracleConfig`. The
# scripts/install.sh script copies this file to /etc/oracle/<family>.env (mode 0600)
# only if no env file is already present, so operator edits are never overwritten.

# ---- Solana RPC / WebSocket (must match the cluster where ESCROW_PROGRAM_ID is deployed) ----
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# ---- Oracle keypair (must match the oracle_authority chosen at FundPayment time) ----
ORACLE_KEYPAIR_PATH=/var/lib/oracle/<family>/oracle-keypair.json

# ---- SLA-Escrow program (defaults to the crate's compiled-in id) ----
# ESCROW_PROGRAM_ID=

# ---- HTTP API bind ----
BIND_ADDR=0.0.0.0:4020

# ---- Pipeline timing ----
EVALUATION_TIMEOUT_MS=30000

# ---- Evidence registry (mirrors are tried in order; first hash-valid wins) ----
EVIDENCE_REGISTRY_URL=https://your-registry.example.com/evidence
# EVIDENCE_REGISTRY_URLS=https://primary.example.com/r,https://mirror.example.com/r
# EVIDENCE_REGISTRY_AUTH_HEADER=Bearer your-token
EVIDENCE_FETCH_MAX_RETRIES=3
EVIDENCE_FETCH_RETRY_BASE_MS=200

# ---- Postgres ledger (REQUIRED for the registration HTTP API). Run migrations/init.sql first. ----
DATABASE_URL=postgres://user:password@host:5432/oracle

# ---- Registration HTTP / storage backend ----
# One of: postgres | s3 | local
ORACLE_REGISTRY_BACKEND=postgres
ORACLE_REGISTRY_MAX_BYTEA_BYTES=4194304
ORACLE_REGISTRY_MAX_BLOB_BYTES=5368709120

# ---- S3-compatible (only used when ORACLE_REGISTRY_BACKEND=s3) ----
# ORACLE_REGISTRY_S3_ENDPOINT=https://s3.amazonaws.com
# ORACLE_REGISTRY_S3_BUCKET=oracle-blobs
# ORACLE_REGISTRY_S3_ACCESS_KEY=
# ORACLE_REGISTRY_S3_SECRET_KEY=
# ORACLE_REGISTRY_S3_REGION=us-east-1

# ---- Operator manual-evaluate (POST /evaluate) ----
# Prefer the SHA-256 hex digest in production.
# ORACLE_OPERATOR_TOKEN_SHA256=<64_HEX_CHARS>
# ORACLE_OPERATOR_TOKEN=dev-only-token
# ORACLE_ALLOW_UNAUTHENTICATED_MANUAL_EVALUATE=false
# ORACLE_MANUAL_EVALUATE_RATE_LIMIT=30
# ORACLE_MANUAL_EVALUATE_RATE_WINDOW_MS=60000

# ---- CORS (defaults to no browser origins; set explicit operator-console origins) ----
# ORACLE_CORS_ALLOWED_ORIGINS=https://ops.example.com

# ---- Evaluation policy ----
ORACLE_STRICT_PROFILE=true
ORACLE_DEAD_LETTER_MAX_ATTEMPTS=5
ORACLE_JOB_CHANNEL_CAPACITY=256

# ---- Chain monitor hardening ----
# Refuse to emit a job from a log notification unless the transaction includes
# a matching DeliverySubmittedEvent program-data line. Recommended on mainnet.
ORACLE_REQUIRE_EVENT_MATCH=false
ORACLE_BACKFILL_LOOKBACK_SIGNATURES=2000

# ---- Family-specific overrides ----
# (oracle-onchain-transfer only)
# TRANSFER_CLUSTER=devnet

# ---- Logging ----
RUST_LOG=oracle_common=info,tower_http=info
