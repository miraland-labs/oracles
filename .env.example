# Copy to /etc/oracle/<family>.env and adjust for your deployment.
#
# Every variable below is consumed by `oracle_common::config::OracleConfig`. The
# scripts/install.sh script copies this file to /etc/oracle/<family>.env (mode 0600)
# only if no env file is already present, so operator edits are never overwritten.

# ---- Solana RPC / WebSocket (must match the cluster where ESCROW_PROGRAM_ID is deployed) ----
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# ---- Oracle keypair (must match the oracle_authority chosen at FundPayment time) ----
ORACLE_KEYPAIR_PATH=/var/lib/oracle/<family>/oracle-keypair.json

# ---- SLA-Escrow program (defaults to the crate's compiled-in id) ----
# ESCROW_PROGRAM_ID=

# ---- HTTP API bind ----
BIND_ADDR=0.0.0.0:4020

# ---- Pipeline timing ----
EVALUATION_TIMEOUT_MS=30000

# ---- Evidence registry (mirrors are tried in order; first hash-valid wins) ----
EVIDENCE_REGISTRY_URL=https://your-registry.example.com/evidence
# EVIDENCE_REGISTRY_URLS=https://primary.example.com/r,https://mirror.example.com/r
# EVIDENCE_REGISTRY_AUTH_HEADER=Bearer your-token
EVIDENCE_FETCH_MAX_RETRIES=3
EVIDENCE_FETCH_RETRY_BASE_MS=200

# ---- Postgres ledger (REQUIRED for the registration HTTP API). Run migrations/init.sql first. ----
DATABASE_URL=postgres://user:password@host:5432/oracle

# ---- Registration HTTP / storage backend ----
# One of: postgres | s3 | local
ORACLE_REGISTRY_BACKEND=postgres
ORACLE_REGISTRY_MAX_BYTEA_BYTES=4194304
ORACLE_REGISTRY_MAX_BLOB_BYTES=5368709120

# ---- S3-compatible (only used when ORACLE_REGISTRY_BACKEND=s3) ----
# ORACLE_REGISTRY_S3_ENDPOINT=https://s3.amazonaws.com
# ORACLE_REGISTRY_S3_BUCKET=oracle-blobs
# ORACLE_REGISTRY_S3_ACCESS_KEY=
# ORACLE_REGISTRY_S3_SECRET_KEY=
# ORACLE_REGISTRY_S3_REGION=us-east-1

# ---- Operator manual-evaluate (POST /evaluate) ----
# Prefer the SHA-256 hex digest in production.
# ORACLE_OPERATOR_TOKEN_SHA256=<64_HEX_CHARS>
# ORACLE_OPERATOR_TOKEN=dev-only-token
# ORACLE_ALLOW_UNAUTHENTICATED_MANUAL_EVALUATE=false
# ORACLE_MANUAL_EVALUATE_RATE_LIMIT=30
# ORACLE_MANUAL_EVALUATE_RATE_WINDOW_MS=60000

# ---- CORS (defaults to no browser origins; set explicit operator-console origins) ----
# ORACLE_CORS_ALLOWED_ORIGINS=https://ops.example.com

# ---- Evaluation policy ----
ORACLE_STRICT_PROFILE=true
ORACLE_DEAD_LETTER_MAX_ATTEMPTS=5
ORACLE_JOB_CHANNEL_CAPACITY=256

# ---- Chain monitor hardening ----
# Refuse to emit a job from a log notification unless the transaction includes
# a matching DeliverySubmittedEvent program-data line. Recommended on mainnet.
ORACLE_REQUIRE_EVENT_MATCH=false
ORACLE_BACKFILL_LOOKBACK_SIGNATURES=2000

# ---- Family-specific overrides ----
# (oracle-onchain-transfer only)
# TRANSFER_CLUSTER=devnet

# ---- Logging ----
RUST_LOG=oracle_common=info,tower_http=info

# =============================================================================
# Active Guardian (retry + fail-closed reject)
# =============================================================================
# When a pipeline run fails with a retriable error (SLA / evidence not yet in the
# registry, transient evaluation failure), the worker retries with exponential
# backoff. If retries exhaust OR `expires_at` approaches within the safety
# margin, the worker issues a protective REJECT so the buyer is refunded before
# expiry instead of losing access to their funds. Defaults match the
# `oracle_common` library defaults; override only if you have a measurement.

# Initial retry delay. The actual wait grows as
#   delay = initial × 2^retry_count, capped by ORACLE_RETRY_MAX_DELAY_SEC.
ORACLE_RETRY_INITIAL_DELAY_SEC=10

# Maximum cap for the exponential backoff between retries.
ORACLE_RETRY_MAX_DELAY_SEC=120

# Maximum retry attempts before the worker gives up and issues a guardian REJECT
# with reason `EVALUATION_TIMEOUT` (102).
ORACLE_MAX_RETRY_ATTEMPTS=30

# Safety margin (seconds) before `Payment.expires_at` at which the worker issues
# a protective REJECT regardless of remaining retries. MUST be strictly larger
# than the on-chain `Config.delivery_cutoff_seconds` (default 300) so the oracle
# absorbs RPC + tx-confirmation latency. 600s = 10 minutes is the recommended
# default; lower only if you have measurements showing your RPC + settle path is
# faster than typical devnet.
ORACLE_REJECT_SAFETY_MARGIN_SEC=600


# =============================================================================
# Operator Economics: Tip-Floor Gate (default OFF)
# =============================================================================
# When ON, the worker eagerly rejects any payment whose projected oracle tip
# (`Payment.amount × Payment.oracle_fee_bps / 10_000`) falls below the
# operator's resolved per-mint floor. Rejected payments get a ConfirmOracle
# verdict with `resolution_reason = 200` (TIP_BELOW_OPERATOR_FLOOR), which:
#   * Refunds eligibility immediately on-chain (Facilitator can sweep within
#     seconds — see pr402/docs/REFUND_SWEEPER.md).
#   * Is observable to reputation indexers — sellers can switch to oracles
#     whose floors match their pricing.
#
# Default OFF preserves backward-compatible behavior: every eligible job
# settles regardless of tip size. Operators opt in by setting the master
# switch below.

# Master switch. Default false (every job settles).
ORACLE_TIP_FLOOR_ENABLED=false

# Default minimum-tip floor in raw mint units (NO dollars; conversion is the
# operator's concern, not the daemon's). USDC has 6 decimals so 5000 ≈ $0.005.
# When unset, falls back to the USDC convention ($0.005) only for USDC mints
# (mainnet `EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v` and devnet
# `4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU`); other mints get a zero
# floor (accept all). Only consulted when ORACLE_TIP_FLOOR_ENABLED=true.
# ORACLE_MIN_VERDICT_TIP_DEFAULT_RAW=5000

# Per-mint overrides (highest priority, beats both default and USDC convention).
# JSON map of `{"<mint_pubkey_base58>": <u64_raw_units>}`. SOL has 9 decimals so
# 30000 lamports ≈ $0.003 at SOL = $100. Keep dollar-equivalent floors
# consistent across mints unless you have a reason to discriminate.
# ORACLE_MIN_VERDICT_TIP_BY_MINT_RAW={"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v":5000,"So11111111111111111111111111111111111111112":30000}
