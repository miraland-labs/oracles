# =============================================================================
# Reference env file: oracle-onchain-transfer running against Solana MAINNET.
# =============================================================================
#
# CLUSTER: mainnet — production secrets. Treat this file as sensitive.
#
# Install:
#   sudo install -d -m 0750 /etc/oracle
#   sudo install -m 0640 -o root -g root onchain-transfer-mainnet.env.example \
#       /etc/oracle/onchain-transfer-mainnet.env
#   sudo -e /etc/oracle/onchain-transfer-mainnet.env   # fill in real values
#
# Path conventions:
# - ORACLE_KEYPAIR_PATH is the *container-internal* path; the systemd unit's
#   -v mount lands the host file at /keys/oracle-keypair.json read-only.
# - DATABASE_URL and BIND_ADDR use 127.0.0.1 because the unit runs with
#   --network host (the container shares the host's network namespace).
# - This unit binds on port 4031 to coexist with the devnet unit on 4021.

# ----- Required: cluster + RPC -----

# Use a paid mainnet RPC tier. Public RPCs throttle aggressively and the
# oracle's getTransaction(jsonParsed) hot path will rate-limit.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Mainnet sla-escrow program ID — the actual deployed value, NOT the
# devnet ID. Cross-check on Solana Explorer before going live.
ESCROW_PROGRAM_ID=

# Pin to the cluster the RPC URLs point at; mismatched evidence rejects.
TRANSFER_CLUSTER=mainnet

# ----- Required: identity -----

# Container-internal path; the systemd unit mounts the host file at this
# location read-only. Don't change unless you also change the unit.
ORACLE_KEYPAIR_PATH=/keys/oracle-keypair.json

# ----- Required: storage -----

# Per-cluster Postgres database. Both clusters share the host's Postgres
# instance but each cluster has its own database for blast-radius isolation.
DATABASE_URL=postgres://oracle_app:CHANGE_ME@127.0.0.1:5432/oracle_onchain_transfer_mainnet

# Mainnet binds on 4031 to coexist with devnet on 4021. nginx routes by
# port. Don't expose 4031 publicly without TLS.
BIND_ADDR=127.0.0.1:4031

EVIDENCE_REGISTRY_URL=http://127.0.0.1:4031/v1/registry

# ----- Required for production: operator-token gate on POST /evaluate -----

# This is mainnet — the operator-token gate is non-negotiable. Generate
# a different token than the devnet deployment uses.
ORACLE_OPERATOR_TOKEN_SHA256=

# ----- Recommended -----

ORACLE_REGISTRY_BACKEND=postgres
ORACLE_STRICT_PROFILE=true

ORACLE_DEAD_LETTER_MAX_ATTEMPTS=5
ORACLE_JOB_CHANNEL_CAPACITY=256

# Mainnet sees more activity; widen the backfill window so a multi-hour
# downtime doesn't leave deliveries stranded after restart.
ORACLE_BACKFILL_LOOKBACK_SIGNATURES=5000

# ----- Logging -----

# Production verbosity: info on the oracle's own crates, warn on tower-http
# (so a misbehaving client doesn't flood the journal). Crank to `debug`
# only for triage; `trace` in production is expensive.
RUST_LOG=oracle_onchain_transfer=info,oracle_common=info,tower_http=warn
