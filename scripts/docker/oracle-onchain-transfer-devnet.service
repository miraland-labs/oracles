# systemd unit for the Dockerized `oracle-onchain-transfer` running
# against Solana **devnet**.
#
# Install:
#   sudo install -m 0644 oracle-onchain-transfer-devnet.service \
#       /etc/systemd/system/oracle-onchain-transfer-devnet.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now oracle-onchain-transfer-devnet.service
#
# Operate:
#   sudo systemctl status  oracle-onchain-transfer-devnet.service
#   sudo systemctl restart oracle-onchain-transfer-devnet.service
#   sudo journalctl -u oracle-onchain-transfer-devnet.service -f
#   docker logs -f oracle-onchain-transfer-devnet
#
# Prerequisites (set up by `oracle-deploy.sh` in this directory):
#   /etc/oracle/onchain-transfer-devnet.env
#   /var/lib/oracle/onchain-transfer-devnet/oracle-keypair.json (mode 0600)
#   docker image: oracle-onchain-transfer:current

[Unit]
Description=x402 oracle-onchain-transfer (devnet) — Dockerized
Documentation=https://github.com/miraland-labs/oracles
After=docker.service network-online.target postgresql.service
Requires=docker.service
Wants=network-online.target postgresql.service

[Service]
TimeoutStartSec=30
TimeoutStopSec=20

ExecStartPre=-/usr/bin/docker rm -f oracle-onchain-transfer-devnet
ExecStart=/usr/bin/docker run \
    --rm \
    --name oracle-onchain-transfer-devnet \
    --network host \
    --pull=never \
    --read-only \
    --tmpfs /tmp:size=64m \
    --env-file /etc/oracle/onchain-transfer-devnet.env \
    -v /var/lib/oracle/onchain-transfer-devnet/oracle-keypair.json:/keys/oracle-keypair.json:ro \
    --memory 1g \
    --cpus 1 \
    --log-driver journald \
    --log-opt tag=oracle-onchain-transfer-devnet \
    oracle-onchain-transfer:current

ExecStop=/usr/bin/docker stop -t 15 oracle-onchain-transfer-devnet

# Restart policy: on-failure (not always). If the binary panics on bad
# config we want operator intervention, not a tight restart loop.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=3

User=root
Group=root

[Install]
WantedBy=multi-user.target
