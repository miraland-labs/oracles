# =============================================================================
# Reference env file: oracle-file-delivery running against Solana DEVNET
# (Forge preview). Co-exists on the same host as oracle-onchain-transfer.
# =============================================================================
#
# CLUSTER: devnet — DO NOT EDIT for mainnet without operator review.
#
# Isolation vs onchain-transfer on this box (do not reuse any of these):
#   port 4021 / 4031, DBs oracle_onchain_transfer_*, keypairs under
#   /var/lib/oracle/onchain-transfer-*/
#
# Install:
#   sudo bash scripts/docker/oracle-file-delivery-devnet-setup.sh \
#       --keypair /path/to/oracle-keypair.json
#   # or by hand:
#   sudo install -d -m 0750 /etc/oracle
#   sudo install -m 0640 -o root -g root file-delivery-devnet.env.example \
#       /etc/oracle/file-delivery-devnet.env
#   sudo -e /etc/oracle/file-delivery-devnet.env
#
# Path conventions:
# - ORACLE_KEYPAIR_PATH points at the *container-internal* path (where the
#   systemd unit's -v mount lands the host file). Don't change unless you
#   also change the unit's mount target.
# - DATABASE_URL uses the host's loopback (127.0.0.1) because the unit runs
#   with --network host (the container shares the host's network namespace).
#
# Network posture:
# - The default below — `BIND_ADDR=0.0.0.0:4022` — exposes the registry on
#   every interface so preview clients can reach it without an extra
#   reverse proxy. Plain HTTP — fine for devnet.
# - Do not bind 4021 or 4031; those belong to oracle-onchain-transfer.

# ----- Required: cluster + RPC -----

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Devnet sla-escrow program ID (cross-check on chain before deploy).
# The binary's compiled-in default is MAINNET; this var is required on devnet.
ESCROW_PROGRAM_ID=s5zkKiy8FD9nFdAhQZoHHV3G8s4QCPzE4cR9U4Hr4ZH

# ----- Required: Forge preview verdict door -----
#
# Origin only. The binary appends /api/v1/oracle/listings/{id}/artifact.
# Preview API (devnet). Production would be https://forge.http402.trade —
# do not point this preview unit at production.

FORGE_VERDICT_BASE_URL=https://preview.forge.http402.trade

# ----- Required: identity -----

# Container-internal path; the systemd unit mounts the host file at this
# location read-only. Don't change unless you also change the unit.
# Host file: /var/lib/oracle/file-delivery-devnet/oracle-keypair.json
# NEVER copy the onchain-transfer keypair here.
ORACLE_KEYPAIR_PATH=/keys/oracle-keypair.json

# ----- Required: storage -----

# Per-family, per-cluster Postgres database. Shares the host Postgres
# instance with onchain-transfer but is a different database.
DATABASE_URL=postgres://oracle_app:CHANGE_ME@127.0.0.1:5432/oracle_file_delivery_devnet

# --- Network posture ---
#
# Posture A (default): direct bind on every interface. Preview clients
# reach the registry at http://<host_ip>:4022/... directly.
BIND_ADDR=0.0.0.0:4022

# Posture B: behind a TLS-terminating reverse proxy. Comment out the
# line above and uncomment the line below when nginx is fronting
# :443 → 127.0.0.1:4022. Add a *new* location/upstream — do not reuse
# the onchain-transfer 4021/4031 vhost ports.
# BIND_ADDR=127.0.0.1:4022

# Self-reference for the in-process postgres registry backend.
# Keep on loopback regardless of posture.
EVIDENCE_REGISTRY_URL=http://127.0.0.1:4022/v1/registry

# Preview Forge listings are fetched from FORGE_VERDICT_BASE_URL; evidence
# rows in this oracle stay small. Postgres backend avoids standing up MinIO
# on a host that already runs onchain-transfer.
ORACLE_REGISTRY_BACKEND=postgres
ORACLE_REGISTRY_MAX_BYTEA_BYTES=4194304
ORACLE_REGISTRY_MAX_BLOB_BYTES=5368709120

# ----- Required for production: operator-token gate on POST /evaluate -----
# Preview: generate a distinct token from onchain-transfer's.
#   TOKEN=$(openssl rand -hex 32)
#   echo -n "$TOKEN" | sha256sum
ORACLE_OPERATOR_TOKEN_SHA256=

# ----- Recommended -----

ORACLE_STRICT_PROFILE=true

ORACLE_DEAD_LETTER_MAX_ATTEMPTS=5
ORACLE_JOB_CHANNEL_CAPACITY=64
ORACLE_BACKFILL_LOOKBACK_SIGNATURES=2000

EVALUATION_TIMEOUT_MS=60000

# ----- Logging -----

RUST_LOG=oracle_file_delivery=info,oracle_common=info,tower_http=info

# ----- Active Guardian (retry + fail-closed reject) -----

ORACLE_RETRY_INITIAL_DELAY_SEC=10
ORACLE_RETRY_MAX_DELAY_SEC=120
ORACLE_MAX_RETRY_ATTEMPTS=30
ORACLE_REJECT_SAFETY_MARGIN_SEC=600

# ----- Operator Economics: Tip-Floor Gate (default OFF) -----

ORACLE_TIP_FLOOR_ENABLED=false
# ORACLE_MIN_VERDICT_TIP_DEFAULT_RAW=5000
# ORACLE_MIN_VERDICT_TIP_BY_MINT_RAW={"4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU":5000}
