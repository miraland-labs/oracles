# =============================================================================
# Reference env file: oracle-onchain-transfer running against Solana DEVNET.
# =============================================================================
#
# CLUSTER: devnet — DO NOT EDIT for mainnet without operator review.
#
# Install:
#   sudo install -d -m 0750 /etc/oracle
#   sudo install -m 0640 -o root -g root onchain-transfer-devnet.env.example \
#       /etc/oracle/onchain-transfer-devnet.env
#   sudo -e /etc/oracle/onchain-transfer-devnet.env   # fill in real values
#
# Path conventions:
# - ORACLE_KEYPAIR_PATH points at the *container-internal* path (where the
#   systemd unit's -v mount lands the host file). Don't change unless you
#   also change the unit's mount target.
# - DATABASE_URL uses the host's loopback (127.0.0.1) because the unit runs
#   with --network host (the container shares the host's network namespace).
#
# Network posture:
# - The default below — `BIND_ADDR=0.0.0.0:4021` — exposes the registry on
#   every interface so external clients can reach it without an extra
#   reverse proxy. This is the simplest setup that "just works" for devnet.
# - For production hardening (TLS termination, rate limiting, IP allow-list
#   at the edge), switch to the loopback bind below and front the binary
#   with nginx / Caddy / Cloudflare. See "Posture B" near the BIND_ADDR
#   stanza below.

# ----- Required: cluster + RPC -----

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Devnet sla-escrow program ID (cross-check on chain before deploy).
ESCROW_PROGRAM_ID=s5zkKiy8FD9nFdAhQZoHHV3G8s4QCPzE4cR9U4Hr4ZH

# Pin to the cluster the RPC URLs point at; mismatched evidence rejects.
TRANSFER_CLUSTER=devnet

# ----- Required: identity -----

# Container-internal path; the systemd unit mounts the host file at this
# location read-only. Don't change unless you also change the unit.
ORACLE_KEYPAIR_PATH=/keys/oracle-keypair.json

# ----- Required: storage -----

# Per-cluster Postgres database. Both clusters share the host's Postgres
# instance but each cluster has its own database for blast-radius isolation.
DATABASE_URL=postgres://oracle_app:CHANGE_ME@127.0.0.1:5432/oracle_onchain_transfer_devnet

# --- Network posture ---
#
# Posture A (default): direct bind on every interface. External clients
# reach the registry at http://<host_ip>:4021/v1/registry/... directly.
# Plain HTTP — fine for devnet; not recommended for production seller
# bearer flows because the seller's signature and bearer cross unencrypted.
BIND_ADDR=0.0.0.0:4021

# Posture B: behind a TLS-terminating reverse proxy (nginx / Caddy /
# Cloudflare). Comment out the line above and uncomment the line below
# when nginx is fronting :443 → 127.0.0.1:4021.
# BIND_ADDR=127.0.0.1:4021

# Self-reference: the oracle uses this URL to publish its own evidence
# back to itself when the registry backend is `postgres` (in-process
# call elides the HTTP hop, but a sibling oracle pointed at the same
# Postgres can still resolve it). Keep on loopback regardless of posture
# — the value never crosses the public internet.
EVIDENCE_REGISTRY_URL=http://127.0.0.1:4021/v1/registry

# ----- Required for production: operator-token gate on POST /evaluate -----

# Generate the SHA-256 of a fresh hex token:
#   TOKEN=$(openssl rand -hex 32)
#   echo -n "$TOKEN" | sha256sum
# Paste the hex here (NOT the raw token); store the raw token in your secret
# manager and distribute to operators only.
ORACLE_OPERATOR_TOKEN_SHA256=

# ----- Recommended -----

ORACLE_REGISTRY_BACKEND=postgres
ORACLE_STRICT_PROFILE=true

ORACLE_DEAD_LETTER_MAX_ATTEMPTS=5
ORACLE_JOB_CHANNEL_CAPACITY=256
ORACLE_BACKFILL_LOOKBACK_SIGNATURES=2000

# ----- Logging -----

RUST_LOG=oracle_onchain_transfer=info,oracle_common=info,tower_http=info

# ----- Active Guardian (retry + fail-closed reject) -----
# When a pipeline run fails with a retriable error (SLA / evidence not in registry,
# transient failure), the worker retries with exponential backoff. If retries exhaust
# OR `expires_at` approaches within the safety margin, the worker issues a protective
# REJECT so the buyer is refunded before expiry. Defaults match the `oracle_common`
# library defaults; override only with measurement.

ORACLE_RETRY_INITIAL_DELAY_SEC=10
ORACLE_RETRY_MAX_DELAY_SEC=120
ORACLE_MAX_RETRY_ATTEMPTS=30

# Safety margin (seconds) before `Payment.expires_at`. MUST be strictly larger than
# the on-chain `Config.delivery_cutoff_seconds` (default 300) so the oracle absorbs
# RPC + tx-confirmation latency. 600s = 10 minutes is the recommended default.
ORACLE_REJECT_SAFETY_MARGIN_SEC=600

# ----- Operator Economics: Tip-Floor Gate (default OFF) -----
# When ON, the worker eagerly rejects any payment whose projected oracle tip
# (`Payment.amount × Payment.oracle_fee_bps / 10_000`) falls below the operator's
# resolved per-mint floor. Rejected payments get a ConfirmOracle verdict with
# `resolution_reason = 200` (TIP_BELOW_OPERATOR_FLOOR). See oracles/.env.example
# for the full description.
#
# Default OFF preserves backward-compatible behavior: every eligible job settles
# regardless of tip size. Operators opt in explicitly.

ORACLE_TIP_FLOOR_ENABLED=false

# Default minimum-tip floor in raw mint units (NO dollars; conversion is the operator's
# concern). USDC has 6 decimals so 5000 raw ≈ $0.005. Only consulted when
# ORACLE_TIP_FLOOR_ENABLED=true.
# ORACLE_MIN_VERDICT_TIP_DEFAULT_RAW=5000

# Per-mint overrides (highest priority; beats the default and the USDC convention).
# JSON map of `{"<mint_pubkey_base58>": <u64_raw_units>}`. Devnet USDC = 4zMMC...
# ORACLE_MIN_VERDICT_TIP_BY_MINT_RAW={"4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU":5000,"So11111111111111111111111111111111111111112":30000}
