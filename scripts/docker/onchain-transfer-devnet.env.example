# =============================================================================
# Reference env file: oracle-onchain-transfer running against Solana DEVNET.
# =============================================================================
#
# CLUSTER: devnet — DO NOT EDIT for mainnet without operator review.
#
# Install:
#   sudo install -d -m 0750 /etc/oracle
#   sudo install -m 0640 -o root -g root onchain-transfer-devnet.env.example \
#       /etc/oracle/onchain-transfer-devnet.env
#   sudo -e /etc/oracle/onchain-transfer-devnet.env   # fill in real values
#
# Path conventions:
# - ORACLE_KEYPAIR_PATH points at the *container-internal* path (where the
#   systemd unit's -v mount lands the host file). Don't change unless you
#   also change the unit's mount target.
# - DATABASE_URL and BIND_ADDR use the host's loopback (127.0.0.1) because
#   the unit runs with --network host (the container shares the host's
#   network namespace).

# ----- Required: cluster + RPC -----

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Devnet sla-escrow program ID (cross-check on chain before deploy).
ESCROW_PROGRAM_ID=s5zkKiy8FD9nFdAhQZoHHV3G8s4QCPzE4cR9U4Hr4ZH

# Pin to the cluster the RPC URLs point at; mismatched evidence rejects.
TRANSFER_CLUSTER=devnet

# ----- Required: identity -----

# Container-internal path; the systemd unit mounts the host file at this
# location read-only. Don't change unless you also change the unit.
ORACLE_KEYPAIR_PATH=/keys/oracle-keypair.json

# ----- Required: storage -----

# Per-cluster Postgres database. Both clusters share the host's Postgres
# instance but each cluster has its own database for blast-radius isolation.
DATABASE_URL=postgres://oracle_app:CHANGE_ME@127.0.0.1:5432/oracle_onchain_transfer_devnet

# Devnet binds on a different port than mainnet; nginx (or your load
# balancer) routes by port. Don't expose 4021 publicly without TLS.
BIND_ADDR=127.0.0.1:4021

EVIDENCE_REGISTRY_URL=http://127.0.0.1:4021/v1/registry

# ----- Required for production: operator-token gate on POST /evaluate -----

# Generate the SHA-256 of a fresh hex token:
#   TOKEN=$(openssl rand -hex 32)
#   echo -n "$TOKEN" | sha256sum
# Paste the hex here (NOT the raw token); store the raw token in your secret
# manager and distribute to operators only.
ORACLE_OPERATOR_TOKEN_SHA256=

# ----- Recommended -----

ORACLE_REGISTRY_BACKEND=postgres
ORACLE_STRICT_PROFILE=true

ORACLE_DEAD_LETTER_MAX_ATTEMPTS=5
ORACLE_JOB_CHANNEL_CAPACITY=256
ORACLE_BACKFILL_LOOKBACK_SIGNATURES=2000

# ----- Logging -----

RUST_LOG=oracle_onchain_transfer=info,oracle_common=info,tower_http=info
