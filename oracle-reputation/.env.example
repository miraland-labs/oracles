# oracle-reputation environment template.
#
# Copy to /etc/oracle/reputation.env (mode 0600) before starting the binary.
# This is a stand-alone indexer — it does NOT need an oracle keypair, evidence
# registry, S3 backend, or any of the OracleConfig knobs.

# ---- Solana cluster (must match the cluster where ESCROW_PROGRAM_ID is deployed) ----
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# ---- SLA-Escrow program (defaults to the linked sla-escrow-api crate's id) ----
# ESCROW_PROGRAM_ID=

# ---- Postgres ledger (REQUIRED). Run migrations/001_init.sql first. ----
DATABASE_URL=postgres://oracle:secret@127.0.0.1:5432/oracle_reputation

# ---- Backfill on startup (capped fetch; never replays the whole chain) ----
# 0 disables backfill (subscribe-only mode).
REPUTATION_BACKFILL_LOOKBACK_SIGNATURES=2000

# ---- Logging ----
RUST_LOG=oracle_reputation=info,tower_http=info
