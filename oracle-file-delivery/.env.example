# oracle-file-delivery environment template.
#
# Copy to /etc/oracle/file-delivery.env (mode 0600) before starting the binary.
# The S3-compatible (or MinIO) backend is recommended here because blobs may
# exceed the 4 MiB Postgres BYTEA cap.

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
ORACLE_KEYPAIR_PATH=/var/lib/oracle/file-delivery/oracle-keypair.json

# ESCROW_PROGRAM_ID=

BIND_ADDR=0.0.0.0:4022
EVALUATION_TIMEOUT_MS=60000

EVIDENCE_REGISTRY_URL=https://your-registry.example.com/evidence
EVIDENCE_FETCH_MAX_RETRIES=3
EVIDENCE_FETCH_RETRY_BASE_MS=200

DATABASE_URL=postgres://oracle:secret@127.0.0.1:5432/oracle_file_delivery

# Default to S3-compatible (MinIO) for blob storage. See scripts/bootstrap-minio.sh.
ORACLE_REGISTRY_BACKEND=s3
ORACLE_REGISTRY_MAX_BYTEA_BYTES=4194304
ORACLE_REGISTRY_MAX_BLOB_BYTES=5368709120

ORACLE_REGISTRY_S3_ENDPOINT=http://127.0.0.1:9000
ORACLE_REGISTRY_S3_BUCKET=oracle-blobs
ORACLE_REGISTRY_S3_ACCESS_KEY=oracletest
ORACLE_REGISTRY_S3_SECRET_KEY=oracletest
ORACLE_REGISTRY_S3_REGION=us-east-1

# ORACLE_OPERATOR_TOKEN_SHA256=
# ORACLE_OPERATOR_TOKEN=

ORACLE_STRICT_PROFILE=true
ORACLE_DEAD_LETTER_MAX_ATTEMPTS=5
ORACLE_JOB_CHANNEL_CAPACITY=64
ORACLE_REQUIRE_EVENT_MATCH=false
ORACLE_BACKFILL_LOOKBACK_SIGNATURES=2000

# ---- Active Guardian (retry + fail-closed reject) ----
ORACLE_RETRY_INITIAL_DELAY_SEC=10
ORACLE_RETRY_MAX_DELAY_SEC=120
ORACLE_MAX_RETRY_ATTEMPTS=30
ORACLE_REJECT_SAFETY_MARGIN_SEC=600

# ---- Operator economics: tip-floor gate (default OFF) ----
# See oracles/.env.example for the full description and per-mint override map.
ORACLE_TIP_FLOOR_ENABLED=false
# ORACLE_MIN_VERDICT_TIP_DEFAULT_RAW=5000
# ORACLE_MIN_VERDICT_TIP_BY_MINT_RAW={}

RUST_LOG=oracle_file_delivery=info,oracle_common=info,tower_http=info
